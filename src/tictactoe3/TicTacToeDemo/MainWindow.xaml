<Window x:Class="TicTacToeDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tic Tac Toe Demo" Height="450" Width="350"
        WindowStartupLocation="CenterScreen" Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status Message -->
        <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>

        <!-- Game Board -->
        <UniformGrid Grid.Row="1" Rows="3" Columns="3" Margin="20">
            <Button Name="Btn0" Content="" FontSize="40" Margin="5" Background="White" BorderBrush="#CCCCCC" Click="Cell_Click"/>
            <Button Name="Btn1" Content="" FontSize="40" Margin="5" Background="White" BorderBrush="#CCCCCC" Click="Cell_Click"/>
            <Button Name="Btn2" Content="" FontSize="40" Margin="5" Background="White" BorderBrush="#CCCCCC" Click="Cell_Click"/>
            <Button Name="Btn3" Content="" FontSize="40" Margin="5" Background="White" BorderBrush="#CCCCCC" Click="Cell_Click"/>
            <Button Name="Btn4" Content="" FontSize="40" Margin="5" Background="White" BorderBrush="#CCCCCC" Click="Cell_Click"/>
            <Button Name="Btn5" Content="" FontSize="40" Margin="5" Background="White" BorderBrush="#CCCCCC" Click="Cell_Click"/>
            <Button Name="Btn6" Content="" FontSize="40" Margin="5" Background="White" BorderBrush="#CCCCCC" Click="Cell_Click"/>
            <Button Name="Btn7" Content="" FontSize="40" Margin="5" Background="White" BorderBrush="#CCCCCC" Click="Cell_Click"/>
            <Button Name="Btn8" Content="" FontSize="40" Margin="5" Background="White" BorderBrush="#CCCCCC" Click="Cell_Click"/>
        </UniformGrid>

        <!-- Reset Button -->
        <Button Grid.Row="2" Content="Reset Game" FontSize="16" Padding="10,5" 
                HorizontalAlignment="Center" Margin="10" Click="Reset_Click"/>
    </Grid>
</Window>