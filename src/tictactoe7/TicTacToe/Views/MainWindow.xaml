<Window x:Class="TicTacToe.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:TicTacToe.ViewModels"
 Title="Tris" Width="460" Height="760" MinWidth="380" MinHeight="700"
 WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Segoe UI">
 <Window.DataContext><vm:MainViewModel /></Window.DataContext>
 <Window.Resources>
  <Style x:Key="CellButton" TargetType="Button">
   <Setter Property="Background" Value="White" />
   <Setter Property="Foreground" Value="#2563EB" />
   <Setter Property="BorderBrush" Value="#D9E2EF" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="FontSize" Value="48" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="Margin" Value="5" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB" /></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB" /><Setter TargetName="Surface" Property="BorderThickness" Value="3" /></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DBEAFE" /></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Symbol}" Value="O"><Setter Property="Foreground" Value="#B45309" /></DataTrigger>
    <DataTrigger Binding="{Binding IsWinning}" Value="True"><Setter Property="Background" Value="#DCFCE7" /><Setter Property="BorderBrush" Value="#15803D" /></DataTrigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
   <RowDefinition Height="*" /><RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Tris" FontSize="32" FontWeight="Bold" Foreground="#172033" HorizontalAlignment="Center" />
   <TextBlock Text="Tu: X  •  PC: O" FontSize="16" Foreground="#526176" Margin="0,8,0,0" HorizontalAlignment="Center" />
   <Border Background="White" CornerRadius="12" Padding="12" Margin="0,16,0,12">
    <UniformGrid Columns="3">
     <StackPanel><TextBlock Text="TU Â· X" Foreground="#2563EB" HorizontalAlignment="Center" /><TextBlock Text="{Binding HumanWins}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" /></StackPanel>
     <StackPanel><TextBlock Text="PAREGGI" Foreground="#526176" HorizontalAlignment="Center" /><TextBlock Text="{Binding Draws}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" /></StackPanel>
     <StackPanel><TextBlock Text="PC Â· O" Foreground="#B45309" HorizontalAlignment="Center" /><TextBlock Text="{Binding ComputerWins}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" /></StackPanel>
    </UniformGrid>
   </Border>
   <Label Content="_DifficoltÃ  del PC" Target="{Binding ElementName=DifficultySelector}" Foreground="#526176" />
   <ComboBox x:Name="DifficultySelector" ItemsSource="{Binding Difficulties}" DisplayMemberPath="Label" SelectedValuePath="Value"
    SelectedValue="{Binding SelectedDifficulty, Mode=TwoWay}" IsEnabled="{Binding CanChangeDifficulty}"
    FontSize="15" Padding="10,7" AutomationProperties.Name="DifficoltÃ  del PC"
    ToolTip="Per cambiare difficoltÃ  durante una partita premi prima Reset." />
  </StackPanel>
  <StackPanel Grid.Row="1" Margin="0,18,0,12">
   <TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" TextAlignment="Center" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" Foreground="#172033" />
   <TextBlock Text="{Binding Hint}" TextAlignment="Center" TextWrapping="Wrap" Foreground="#526176" Margin="0,6,0,0" />
  </StackPanel>
  <Viewbox Grid.Row="2" Stretch="Uniform" Margin="0,0,0,16">
   <ItemsControl ItemsSource="{Binding Cells}" Width="330" Height="330">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="3" Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Button Content="{Binding Symbol}" Style="{StaticResource CellButton}"
       AutomationProperties.Name="{Binding AccessibleName}"
       Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
       CommandParameter="{Binding Index}" />
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </Viewbox>
  <StackPanel Grid.Row="3">
  <Button Content="_Reset" Command="{Binding ResetCommand}" Height="44"
   FontSize="16" FontWeight="SemiBold" Background="#172033" Foreground="White" Cursor="Hand"
   AutomationProperties.Name="Reset: nuova partita" ToolTip="Azzera la griglia e conserva i punteggi." />
   <Button Content="Azzera punteggi" Command="{Binding ClearScoresCommand}" HorizontalAlignment="Center" Margin="0,10,0,0" Padding="8,4" Background="Transparent" BorderThickness="0" Foreground="#526176" Cursor="Hand" />
   <TextBlock Text="Punteggi della sessione Â· tutti i livelli" HorizontalAlignment="Center" FontSize="11" Foreground="#526176" Margin="0,4,0,0" />
  </StackPanel>
 </Grid>
</Window>

