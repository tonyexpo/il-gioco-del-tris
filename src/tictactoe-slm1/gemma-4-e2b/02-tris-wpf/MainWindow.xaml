<Window x:Class="TicTacToeWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tic-Tac-Toe (Minecraft Style)" Height="450" Width="600">
    <Grid>
        <!-- Game Board Area -->
        <Grid x:Name="GameGrid" Background="#8B4513"> <!-- Brownish block color for Minecraft feel -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Display for Status/Score -->
            <TextBlock Grid.Row="0" Text="Human (X) vs PC (O)" FontSize="24" FontWeight="Bold" Foreground="White" Margin="10"/>

            <!-- 3x3 Game Board using Grid for block appearance -->
            <Grid x:Name="GameBoard">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cells (Blocks) -->
                <Border Grid.Row="0" Grid.Column="0" Background="#4CAF50" Click="Cell_Click" Name="Cell00"/>
                <Border Grid.Row="0" Grid.Column="1" Background="#4CAF50" Click="Cell_Click" Name="Cell01"/>
                <Border Grid.Row="0" Grid.Column="2" Background="#4CAF50" Click="Cell_Click" Name="Cell02"/>

                <Border Grid.Row="1" Grid.Column="0" Background="#4CAF50" Click="Cell_Click" Name="Cell10"/>
                <Border Grid.Row="1" Grid.Column="1" Background="#4CAF50" Click="Cell_Click" Name="Cell11"/>
                <Border Grid.Row="1" Grid.Column="2" Background="#4CAF50" Click="Cell_Click" Name="Cell12"/>

                <Border Grid.Row="2" Grid.Column="0" Background="#4CAF50" Click="Cell_Click" Name="Cell20"/>
                <Border Grid.Row="2" Grid.Column="1" Background="#4CAF50" Click="Cell_Click" Name="Cell21"/>
                <Border Grid.Row="2" Grid.Column="2" Background="#4CAF50" Click="Cell_Click" Name="Cell22"/>
            </Grid>

            <!-- Reset Button -->
            <Button Grid.Row="2" Content="Reset Game" Margin="10" Height="40" FontSize="16" Click="ResetButton_Click"/>

            <!-- Status Display -->
            <TextBlock Grid.Row="3" Text="Status: Waiting for X to move..." FontSize="18" Foreground="Yellow" Margin="10"/>
        </Grid>
    </Grid>
</Window>