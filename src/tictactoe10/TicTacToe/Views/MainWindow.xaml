<Window x:Class="TicTacToe.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tris — Tic Tac Toe"
        Width="420" Height="540"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CellButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="Width" Value="105"/>
            <Setter Property="Height" Value="105"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Background" Value="#F7F7F7"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
            <Setter Property="Foreground" Value="#2B2B2B"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Stato della partita -->
        <TextBlock Grid.Row="0"
                   Text="{Binding StatusText}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="18"
                   Margin="0,4,0,16"/>

        <!-- Griglia 3x3 -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3" Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource CellButton}"
                            Content="{Binding Content}"
                            IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBool}}"
                            Command="{Binding DataContext.CellClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Reset -->
        <Button Grid.Row="2"
                Content="Reset"
                Command="{Binding ResetCommand}"
                Width="150" Height="42"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"/>
    </Grid>
</Window>
